# ============================================
# Crypto DeepSeek 交易系统环境变量配置模板
# ============================================
# 
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 编辑 .env 文件，填写你的实际API密钥
# 3. 注意：.env 文件包含敏感信息，不要提交到Git仓库
#
# ============================================

# AI API 配置（必需）
# 支持 DeepSeek, OpenAI 等兼容 OpenAI API 的服务
# DeepSeek: 从 https://platform.deepseek.com/ 获取你的API密钥
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# OKX 交易所 API 配置（必需）
# 从 https://www.okx.com/account/my-api 获取你的API密钥
EXCHANGE_API_KEY=your-okx-api-key-here
EXCHANGE_SECRET=your-okx-secret-key-here
EXCHANGE_PASSPHRASE=your-okx-passphrase-here
EXCHANGE_ENABLE_SANDBOX=false  # 设置为 true 启用沙箱模式进行测试


# CryptoOracle API 配置（可选）
# 用于情绪分析，如果不使用可以留空
CRYPTORACLE_API_KEY=your-cryptoracle-api-key-here
